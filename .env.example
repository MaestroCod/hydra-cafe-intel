# =============================================================================
# TEMPLATE DE CREDENCIAIS LOCAIS  ->  copie para ".env" e preencha
#   Windows PowerShell : Copy-Item .env.example .env
#   Linux / macOS      : cp .env.example .env
# NUNCA comite o arquivo .env (ja esta no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AMBIENTE / OBSERVABILIDADE
# -----------------------------------------------------------------------------
APP_ENV=local                       # local | dev | prod
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_DIR=logs

# -----------------------------------------------------------------------------
# 2. ABSTRACAO DE ARMAZENAMENTO (hoje local, amanha AWS S3)
#    STORAGE_BACKEND=local -> escreve em DATA_LAKE_ROOT
#    STORAGE_BACKEND=s3    -> escreve em s3://S3_BUCKET_RAW | S3_BUCKET_PROCESSED
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
DATA_LAKE_ROOT=data_lake

# -----------------------------------------------------------------------------
# 3. AWS (deixe vazio enquanto estiver 100% local)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET_RAW=agro-intel-raw
S3_BUCKET_PROCESSED=agro-intel-processed
# Endpoint alternativo compativel com S3 (MinIO/LocalStack). Vazio = AWS real.
S3_ENDPOINT_URL=

# -----------------------------------------------------------------------------
# 4. COPERNICUS CDS / ADS (ERA5-Land via cdsapi)
#    Obtenha a chave em: https://cds.climate.copernicus.eu/profile
#    O cdsapi tambem aceita o arquivo ~/.cdsapirc; aqui usamos .env como fonte
#    unica de verdade e escrevemos o .cdsapirc programaticamente na Etapa 4.
# -----------------------------------------------------------------------------
CDSAPI_URL=https://cds.climate.copernicus.eu/api
# Formato obrigatorio: <UID>:<APIKEY> (User ID + ":" + token). Ex.: 123456:abcdef...
CDSAPI_KEY=COLE_SEU_UID:COLE_SEU_TOKEN_PESSOAL_AQUI

# -----------------------------------------------------------------------------
# 5. CHIRPS (precipitacao diaria, GeoTIFF via HTTP)
#    O produto "final" tem latencia de ~1-2 meses; o "prelim" e quase tempo real
#    (use a flag --prelim no ingestor). Arquivos: chirps-v2.0.YYYY.MM.DD.tif.gz
# -----------------------------------------------------------------------------
CHIRPS_BASE_URL=https://data.chc.ucsb.edu/products/CHIRPS-2.0/global_daily/tifs/p05
CHIRPS_PRELIM_BASE_URL=https://data.chc.ucsb.edu/products/CHIRPS-2.0/prelim/global_daily/tifs/p05
CHIRPS_TIMEOUT_SECONDS=180
CHIRPS_MAX_RETRIES=3
# Data default da ingestao = hoje - CHIRPS_LAG_DAYS (latencia do produto final)
CHIRPS_LAG_DAYS=45
# Historico puxado no backfill de 1 ano
CHIRPS_LOOKBACK_DAYS=365
# Tamanho do chunk do download por streaming (bytes)
CHIRPS_CHUNK_SIZE_BYTES=1048576

# -----------------------------------------------------------------------------
# 5b. ERA5-Land (reanalise horaria via cdsapi)
#     ATENCAO: max/min_2m_temperature_since_previous_post_processing NAO existem
#     no reanalysis-era5-land (sao do reanalysis-era5-single-levels). O ingestor
#     resolve esses nomes para 2m_temperature horario, de onde tmax/tmin diarios
#     sao derivados na camada processed.
# -----------------------------------------------------------------------------
ERA5_DATASET=reanalysis-era5-land
ERA5_VARIABLES=2m_temperature,maximum_2m_temperature_since_previous_post_processing,minimum_2m_temperature_since_previous_post_processing,total_precipitation,potential_evaporation,volumetric_soil_water_layer_1
ERA5_MAX_RETRIES=3
# Data default da ingestao = hoje - ERA5_LAG_DAYS (latencia do ERA5-Land)
ERA5_LAG_DAYS=6
# Historico puxado no backfill mensal (1 ano = 12 requisicoes ao CDS)
ERA5_LOOKBACK_DAYS=365
ERA5_DATA_FORMAT=netcdf
ERA5_DOWNLOAD_FORMAT=unarchived

# -----------------------------------------------------------------------------
# 6. EIXO FINANCEIRO (Yahoo Finance / yfinance)
#    ESCopo do projeto: apenas CAFE ARABICA tipo 4/5 (KC=F/ICF=F) + cambio BRL=X
# -----------------------------------------------------------------------------
FINANCE_TICKERS=KC=F,ICF=F
FINANCE_FX_TICKERS=BRL=X
# 1 ano para tras (aceita "1y", "6M", "180d" ou "YYYY-MM-DD")
FINANCE_START_DATE=1y
FINANCE_INTERVAL=1d
FINANCE_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# 7. RECORTE ESPACIAL PADRAO (Brasil)
#    Formato WGS84 geografico: min_lon,min_lat,max_lon,max_lat
#    O ingestor converte automaticamente para o formato CDS (N,W,S,E).
# -----------------------------------------------------------------------------
AOI_BBOX=-73.98,-33.75,-28.85,5.27
AOI_NAME=brasil

# -----------------------------------------------------------------------------
# 7b. PROCESSAMENTO (camada Silver / processed)
#     Escopo ativo: cafe arabica tipo 4/5 nos polos do Sul de Minas e
#     Cerrado Mineiro. SCOPE_* vazio = processa todos os polos/commodities.
# -----------------------------------------------------------------------------
SCOPE_COMMODITIES=coffee_arabica
SCOPE_POLOS=Sul_de_Minas,Cerrado_Mineiro
POLOS_GEOJSON_PATH=
WATER_STRESS_WINDOW_DAYS=7
WATER_STRESS_DEFICIT_MM=-30.0
SACA_WEIGHT_KG=60.0

# -----------------------------------------------------------------------------
# 8. BANCO DE DADOS (RDS PostGIS - usado a partir da Etapa 6)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agro_intel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
